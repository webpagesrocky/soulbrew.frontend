# Configuración web del proyecto Firebase.
# Consola de Firebase > Configuración del proyecto > Tus apps > App web.
# Estos valores son públicos por diseño: quien protege los datos son las
# reglas de Firestore, no estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Debe coincidir con la región de setGlobalOptions() en las Cloud Functions.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Ponlo en true para apuntar a los emuladores locales en lugar del proyecto real.
VITE_USE_FIREBASE_EMULATORS=false
